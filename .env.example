PORT=4173

# 服务端模型配置。不要把真实密钥提交到仓库，也不要放进前端环境变量。
IMAGE_API_KEY=replace_me
IMAGE_API_BASE_URL=https://api.example.com/v1
IMAGE_API_MODEL=replace_me

VIDEO_API_KEY=replace_me
VIDEO_API_BASE_URL=https://api.example.com/v1
VIDEO_API_MODEL=replace_me

# 账号安全：生产环境建议保持默认。
# 注册默认必须先完成人机验证，再发送邮箱验证码；仅本地开发排查时才设置 AUTH_ALLOW_DEV_CODE=true。
AUTH_REQUIRE_EMAIL_CODE=true
AUTH_ALLOW_DEV_CODE=false
BLOCK_TEMP_ACCOUNT_EMAIL=true
